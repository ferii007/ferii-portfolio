# Copy this file to .env.local (or .env) and fill in the values. Both are ignored by git.

# Which AI answers the robot chat: google (default, free tier) or anthropic. See src/features/chat/lib/model.js.
AI_PROVIDER=google

# Key for each provider; only the one AI_PROVIDER picks is needed.
# google: Google AI Studio (aistudio.google.com), free tier.
GEMINI_API_KEY=
# anthropic: Anthropic Console (console.anthropic.com), paid credits.
ANTHROPIC_API_KEY=
